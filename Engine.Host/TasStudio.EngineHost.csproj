<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><AssemblyName>TasStudio.EngineHost</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;EngineFixture.cs;WorkerChecks.cs;EngineBenchmark.cs;EngineSearchSimulation.cs;EngineSearchRunner.cs;SearchCacheChecks.cs;CandidateChecks.cs;WaveSearch.cs;PassiveReplay.cs;CollisionChecks.cs;CompatibilityChecks.cs;../Core/**/*.cs" />
    <Reference Include="IGTAP.EngineSim.Runtime"><HintPath>$(EngineRoot)/enginesim/Runtime/bin/Release/net10.0/IGTAP.EngineSim.Runtime.dll</HintPath></Reference>
    <Reference Include="IGTAP.UnityShim"><HintPath>$(EngineRoot)/enginesim/Runtime/bin/Release/net10.0/IGTAP.UnityShim.dll</HintPath></Reference>
    <Reference Include="IGTAP.Box2D"><HintPath>$(EngineRoot)/enginesim/Runtime/bin/Release/net10.0/IGTAP.Box2D.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(EngineRoot)/enginesim/Runtime/bin/Release/net10.0/Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ManagedDir)/Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="LocalEngineRequired" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(EngineRoot)/enginesim/Runtime/bin/Release/net10.0/IGTAP.EngineSim.Runtime.dll')" Text="Run prepare-engine-host.ps1 with a local reference checkout and the installed game. Generated game files are local only." />
  </Target>
</Project>
